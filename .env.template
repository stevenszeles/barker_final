# Barker local configuration
# Copy to .env. Never commit the resulting file.

# Local Docker uses a persistent named volume automatically. Direct Python
# runs use this path unless DATABASE_URL is supplied. Without DATABASE_URL the
# app runs on SQLite in every environment, including production.
WS_DB_PATH=./workstation.db
DATABASE_URL=
WS_DB_FALLBACK_TO_SQLITE=0
WS_DB_POOL_MIN=1
WS_DB_POOL_MAX=4
WS_DB_STATEMENT_TIMEOUT_MS=15000

# Authentication is off by default, locally and in production; every visitor
# is then treated as an administrator. Set BARKER_AUTH_ENABLED=1 to require a
# login; that also requires BARKER_AUTH_SECRET (32+ chars) and
# BARKER_ADMIN_PASSWORD (12+ chars). BARKER_VIEWER_PASSWORD is optional.
BARKER_AUTH_ENABLED=0
BARKER_AUTH_SECRET=
BARKER_ADMIN_PASSWORD=
BARKER_VIEWER_PASSWORD=
BARKER_SESSION_HOURS=12
BARKER_SECURE_COOKIES=0

# Barker no longer has order placement endpoints. This flag is only reported
# in admin settings and does not enable anything.
BARKER_TRADING_ENABLED=0
BARKER_MAX_UPLOAD_BYTES=10485760

WS_API_PREFIX=/api
WS_STATIC_MODE=1
WS_LIVE_QUOTES=0
WS_MARKETDATA_ONLY=0
WS_METHOD_VERSION=v1.0.0

# Add explicit origins only when the frontend is hosted separately.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080
WS_ALLOW_ALL_ORIGINS=0

# Optional read-only Schwab API integration (accounts, positions, balances, orders).
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:8080/api/auth/schwab/callback
SCHWAB_SCOPES=

# Optional market-data integrations. Imported balances remain authoritative.
POLYGON_API_KEY=
OPENFIGI_API_KEY=
OPENFIGI_BASE_URL=https://api.openfigi.com
OPENFIGI_TIMEOUT=6
WS_QUOTE_TIMEOUT=4
WS_QUOTE_MAX_SYMBOLS=80
WS_QUOTE_BATCH=50
WS_SCHWAB_REFRESH_COOLDOWN=60
WS_SCHWAB_TIMEOUT=6

# Optional shared cache. The application works without Redis.
REDIS_URL=
CACHE_TTL=300
